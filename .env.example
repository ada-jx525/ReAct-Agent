# Keep your local model preference. Regression was verified explicitly with 4B.
MODEL=ollama/qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_KEEP_ALIVE=10m
EMBEDDING_TIMEOUT_SECONDS=60

# Local Demo identity only; production must derive identity from verified login.
CUSTOMER_EMAIL=james@example.com
# REACT_AGENT_PROJECT_ROOT=/absolute/path/react-agent
# ORDERS_DB_PATH=/absolute/path/orders.db
# CHECKPOINT_DB_PATH=/absolute/path/agent_checkpoints.db

# Embeddings: cosine thresholds are heuristics, not approval or confidence.
KNOWLEDGE_STRATEGY=adjacent
KNOWLEDGE_MIN_SCORE=0.35
KNOWLEDGE_FETCH_K=10
KNOWLEDGE_RELEVANCE_GAP=0.10
KNOWLEDGE_CONTEXT_CHAR_BUDGET=6000
RERANK_ENABLED=true
# RERANK_MODEL_PATH=/absolute/path/knowledge/models/reranker
# KNOWLEDGE_SOURCE_PATH=/absolute/path/knowledge/policies
# KNOWLEDGE_INDEX_PATH=/absolute/path/knowledge/index/policies-faiss

# No automatic downloads during retrieval; no tracing by default.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Local read-only API: generate a random 32+ character token; never commit it.
# DEMO_API_IDENTITIES={"your-random-token":"james@example.com"}
# API_STATE_DB=/absolute/path/var/api_state.db
